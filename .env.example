# Supabase Postgres connection string. Required.
DATABASE_URL=
# Supabase auth. Required (service role key is server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side Supabase keys (in src/). Required.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Secret used to sign JWTs. Required — use a long random string.
JWT_SECRET=
# Razorpay payment keys (test mode first). Required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret for signature verification of payment events. Required.
RAZORPAY_WEBHOOK_SECRET=
# Twilio credentials for WhatsApp/SMS notifications. Required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_FROM_NUMBER=
# Public base URL of the app (used for links in notifications). Required.
APP_URL=
