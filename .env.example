# Postgres connection string (Neon or local). Required.
DATABASE_URL=
# Secret used to sign JWTs. Required — use a long random string.
JWT_SECRET=
# Razorpay payment keys (test mode first). Required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret for signature verification of payment events. Required.
RAZORPAY_WEBHOOK_SECRET=
# Resend API key for email notifications. Required.
RESEND_API_KEY=
# Twilio credentials for WhatsApp/SMS notifications. Required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public base URL of the app (used for links in notifications). Required.
APP_URL=
