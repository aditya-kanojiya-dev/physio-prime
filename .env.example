# Supabase Postgres connection string. Required.
DATABASE_URL=
# Supabase auth. Required (service role key is server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side Supabase keys (in src/). Required.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Secret used to sign JWTs. Required — use a long random string.
JWT_SECRET=
# Razorpay payment keys (test mode first). Required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret for signature verification of payment events. Required.
RAZORPAY_WEBHOOK_SECRET=
# Twilio credentials for WhatsApp/SMS notifications. Required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_FROM_NUMBER=
# Public base URL of the app (used for links in notifications and CORS). Required.
APP_URL=
# Optional extra browser origins allowed to call the API (comma-separated).
# APP_URL is always allowed, plus its www/apex twin. In production also add
# preview/admin hosts here if they are not the same origin as APP_URL.
# CORS_ORIGINS=https://admin.physio-prime.com,https://preview.example.com
# Reverse-proxy hops for client IP (rate limits). Production default is 1 (Nginx).
# TRUST_PROXY=1
# Optional rate-limit overrides (defaults: auth 20/15m, API 120/min).
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_API_MAX=120
